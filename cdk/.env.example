# Credenciales inyectadas como variables de entorno de las Lambdas durante `cdk deploy`.
# Copiar este archivo a `.env` y completar con los valores reales (NO commitear `.env`).
# Estos valores reemplazan a los antiguos secretos de AWS Secrets Manager.

# Patagonia / DigipWMS API key (antes: secret patagonia-wms/api-key)
PATAGONIA_API_KEY=

# Credenciales de Tiendanube (antes: secret tiendanube/api-credentials)
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_USER_AGENT=Unibrandco Backend (ignaciodiaznanni@gmail.com)

# Gold data — Supabase PostgreSQL (dashboard: gold.fact_ventas / clientes_clasificados / fact_ventas_flete)
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=postgres
